// Passive-Aggressive Error Handling Example
// Demonstrates try/whatever blocks

print "=== Passive-Aggressive Error Handling ==="!

// Example 1: Division by zero (whatever!)
try {
   const result = Number(10) / Number 0!
   print "Result:", result!
} whatever {
   print "Math is hard, let's go shopping"!
}

// Example 2: Undefined variable access (whatever!)
try {
   print nonexistent_variable!
} whatever {
   print "Meh, didn't really need that variable anyway"!
}

// Example 3: Invalid operation (whatever!)
try {
   const broken = String("hello") - Number 5!
   print broken!
} whatever {
   print "Whatever, I didn't want to do that anyway"!
}

// Example 4: Actually successful code
try {
   const x = Number 42!
   print "Success! x =", x!
} whatever {
   print "This shouldn't print"!
}

print "=== Done being passive-aggressive ==="!
