// Agile/Scrum Methodology Satire Demo
// Demonstrates sprint, standup, retro, and burndown keywords

print "🏃 AGILE/SCRUM PROGRAMMING DEMO 🏃"!
print "===================================="!

print ""!
print "Part 1: Sprint Planning"!
print "----------------------"!
sprint {
   print "Implementing user story #42..."!
   const story_points = 13!
   print "Story points committed: ${story_points}"!
   print "Feature: Revolutionary TODO app"!
}!

print ""!
print "Part 2: Daily Standup"!
print "---------------------"!
standup {
   const yesterday = "Attended meetings"!
   const today = "Will attend more meetings"!
   const blockers = "Need to refill coffee"!

   print "Status update delivered!"!
   print "Actual work done: 0"!
}!

print ""!
print "Part 3: Sprint Retrospective"!
print "----------------------------"!
retro {
   print "Team feedback collected..."!
   const likes = "Free pizza"!
   const improvements = "More free pizza"!
   print "Continuous improvement achieved!"!
}!

print ""!
print "Part 4: Burndown Chart"!
print "----------------------"!
burndown {
   print "Tracking progress..."!
   const tasks_completed = 2!
   const tasks_added = 5!
   print "Net progress: Going backwards!"!
}!

print ""!
print "✅ Sprint complete! Time for next sprint..."!
