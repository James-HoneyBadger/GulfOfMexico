// Quantum Programming: Variables in Superposition
// Variables exist in multiple states until observed!

print "⚛️  QUANTUM PROGRAMMING DEMO ⚛️"!
print "================================"!
print ""!

// Quantum variable in superposition of multiple values
print "1. Creating quantum variable in superposition..."!
quantum x [1, 2, 3, 4, 5]!

print ""!
print "2. The variable 'x' now exists in ALL states simultaneously!"!
print "   Until we observe it, it's both 1 AND 2 AND 3 AND 4 AND 5!"!

print ""!
print "3. Observing quantum variable (collapses wavefunction)..."!
const result = observe "x"!
print "   Result: ${result}"!

print ""!
print "4. Quantum uncertainty with 'maybe'..."!
quantum uncertain maybe!
print "   Variable is in true/false superposition!"!

print ""!
print "5. Multiple quantum variables..."!
quantum a [10, 20, 30]!
quantum b [100, 200]!
quantum c ["cat", "dog", "bird"]!

print ""!
print "6. Observing all quantum states..."!
const val_a = observe "a"!
const val_b = observe "b"!
const val_c = observe "c"!

print "   a collapsed to: ${val_a}"!
print "   b collapsed to: ${val_b}"!
print "   c collapsed to: ${val_c}"!

print ""!
print "⚛️  Schrödinger would be proud! ⚛️"!
