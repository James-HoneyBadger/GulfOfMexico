// Emotional Programming Example
// Program mood changes based on execution context

print "=== Emotional Programming Demo ==="!

// Happy mode - executes when no errors
happy {
   print "Everything is going great!"!
   print "Life is good! ☀️"!
}

// Excited mode - random high energy (70% chance)
excited {
   print "WOO HOO! Let's do this!"!
   print "Maximum energy activated!"!
}

// Tired mode - always executes but slowly
tired {
   print "Ugh... processing..."!
   print "This is taking forever..."!
}

// Sad mode - would execute if there were 1-2 errors
sad {
   print "Something went wrong earlier :("!
}

// Angry mode - would execute if there were 3+ errors
angry {
   print "THIS IS UNACCEPTABLE!!!"!
   print "RAGE MODE ACTIVATED!"!
}

print "\n=== Mood swings complete ==="!
