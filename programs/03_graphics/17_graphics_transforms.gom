// Advanced Graphics - Transformations
// Demonstrates transformation stack, rotation, scaling, and translation

const canvas = Canvas(600, 600, "black")!

// Save the initial transform
canvas.saveTransform()!

// Draw a square in the center
canvas.translate(250, 250)!
canvas.rect(-25, -25, 50, 50, "red")!

// Rotate and draw another square
canvas.rotate(45)!
canvas.rect(-25, -25, 50, 50, "blue")!

// Restore original transform
canvas.restoreTransform()!

// Scaling example
canvas.saveTransform()!
canvas.translate(450, 150)!
canvas.scale(2.0)!
canvas.circle(0, 0, 25, "green")!
canvas.restoreTransform()!

// Draw a spiral using rotation
var angle 0!
var radius 10!

function fn drawSpiral() {
   canvas.saveTransform()!
   canvas.translate(300, 450)!
   canvas.rotate(angle)!
   canvas.translate(radius, 0)!
   canvas.circle(0, 0, 5, "cyan")!
   canvas.restoreTransform()!

   var angle angle + 30!
   var radius radius + 5!
}

// Draw multiple rotated elements
drawSpiral()!
drawSpiral()!
drawSpiral()!
drawSpiral()!
drawSpiral()!
drawSpiral()!
drawSpiral()!
drawSpiral()!

// Draw with probabilistic colors and positions
var x 50!
var y 50!

function fn drawRandom() {
   // Each call might draw slightly differently due to "maybe"
   const randomColor = Color(maybe, maybe, maybe)!
   canvas.circle(x, y, 10, randomColor)!
   var x x + 25!
}

drawRandom()!
drawRandom()!
drawRandom()!
drawRandom()!
drawRandom()!

canvas.save("transforms_demo.png")!
print("Transformation demo saved!")!
