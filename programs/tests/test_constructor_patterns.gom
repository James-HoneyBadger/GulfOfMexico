// Test constructors via init pattern

// Test 1: Class with init method
class Person {
   var name = "Unknown"!
   var age = 0!
   
   function init(n, a) => {
      name = n!
      age = a!
   }!
}!

const alice = new Person!
alice.init("Alice", 30)!
print "Test 1 - Init method:"!
print alice.name!  // Should print: Alice
print alice.age!   // Should print: 30

// Test 2: Factory function pattern
function createPerson(n, a) => {
   const p = new Person!
   p.name = n!
   p.age = a!
   return p!
}!

const bob = createPerson("Bob", 25)!
print "Test 2 - Factory pattern:"!
print bob.name!   // Should print: Bob
print bob.age!    // Should print: 25

// Test 3: Class without init (backward compat)
class Simple {
   var value = 42!
}!

const simple = new Simple!
print "Test 3 - No init:"!
print simple.value!  // Should print: 42

print "PASS: Constructor patterns"!
