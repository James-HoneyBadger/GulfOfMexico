// Financial Analysis Demo
// Demonstrates financial calculation functions

print "💰 FINANCIAL ANALYSIS DEMO 💰"!
print "=============================="!
print ""!

// Compound Interest
print "1. Compound Interest Calculation"!
print "---------------------------------"!
const principal = 10000!
const annual_rate = 0.05!  // 5%
const years = 10!
const compounds_per_year = 12!  // Monthly compounding

const final_amount = compound_interest principal, annual_rate, years, compounds_per_year!
print "Principal: $${principal}"!
print "Annual Rate: ${annual_rate * 100}%"!
print "Time: ${years} years"!
print "Compounding: ${compounds_per_year} times per year"!
print "Final Amount: $${final_amount}"!
const interest_earned = final_amount - principal!
print "Interest Earned: $${interest_earned}"!
print ""!

// Simple Interest
print "2. Simple Interest"!
print "------------------"!
const simple_principal = 5000!
const simple_rate = 0.04!  // 4%
const simple_time = 3!

const simple_int = simple_interest simple_principal, simple_rate, simple_time!
print "Principal: $${simple_principal}"!
print "Rate: ${simple_rate * 100}%"!
print "Time: ${simple_time} years"!
print "Interest: $${simple_int}"!
const simple_total = simple_principal + simple_int!
print "Total Amount: $${simple_total}"!
print ""!

// Loan Payment (PMT)
print "3. Loan Payment Calculation"!
print "----------------------------"!
const loan_amount = 250000!  // $250k mortgage
const monthly_rate = 0.045 / 12!  // 4.5% annual / 12 months
const num_payments = 30 * 12!  // 30 years * 12 months

const monthly_payment = pmt monthly_rate, num_payments, loan_amount!
print "Loan Amount: $${loan_amount}"!
print "Annual Rate: 4.5%"!
print "Loan Term: 30 years"!
print "Monthly Payment: $${monthly_payment}"!
const total_paid = monthly_payment * num_payments!
print "Total Paid: $${total_paid}"!
const total_interest = total_paid - loan_amount!
print "Total Interest: $${total_interest}"!
print ""!

// Future Value
print "4. Investment Future Value"!
print "--------------------------"!
const monthly_investment = 500!
const inv_rate = 0.07 / 12!  // 7% annual
const inv_months = 20 * 12!  // 20 years

const future_value = fv inv_rate, inv_months, -monthly_investment, 0!
print "Monthly Investment: $${monthly_investment}"!
print "Annual Return: 7%"!
print "Time Period: 20 years"!
print "Future Value: $${future_value}"!
print ""!

// Present Value
print "5. Present Value Calculation"!
print "-----------------------------"!
const future_needed = 100000!
const pv_rate = 0.06 / 12!
const pv_months = 10 * 12!

const monthly_needed = pv pv_rate, pv_months, -future_needed / pv_months!
print "Future Value Needed: $${future_needed}"!
print "Annual Rate: 6%"!
print "Time: 10 years"!
print "Present Value: $${monthly_needed * pv_months}"!
print ""!

// Net Present Value
print "6. Net Present Value (NPV)"!
print "--------------------------"!
const discount_rate = 0.10!  // 10%
const cash_flows = [-1, -50000, 15000, 18000, 20000, 22000, 25000]!
print "Initial Investment: $50,000"!
print "Annual Cash Flows: $15k, $18k, $20k, $22k, $25k"!
print "Discount Rate: ${discount_rate * 100}%"!

const npv_result = npv discount_rate, cash_flows!
print "Net Present Value: $${npv_result}"!

if npv_result > 0 {
   print "Decision: ACCEPT (Positive NPV)"!
}!
if npv_result < 0 {
   print "Decision: REJECT (Negative NPV)"!
}!
print ""!

// Retirement Planning
print "7. Retirement Savings Plan"!
print "---------------------------"!
const current_age = 30!
const retirement_age = 65!
const retirement_years = retirement_age - current_age!
const monthly_contribution = 1000!
const expected_return = 0.08 / 12!

const retirement_months = retirement_years * 12!
const retirement_fund = fv expected_return, retirement_months, -monthly_contribution, 0!
print "Current Age: ${current_age}"!
print "Retirement Age: ${retirement_age}"!
print "Monthly Contribution: $${monthly_contribution}"!
print "Expected Annual Return: 8%"!
print "Retirement Fund: $${retirement_fund}"!
print ""!

print "✅ Financial calculations complete!"!
