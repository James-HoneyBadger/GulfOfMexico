// Mandelbrot-style Gradient Art
// A simple colorful gradient pattern

print "Creating fractal art..."!

const canvas = Canvas(400, 300, "black")!

// Color palette - blues to whites
const c0 = Color(0, 0, 51)!     // Dark blue
const c1 = Color(0, 0, 102)!    // Medium blue  
const c2 = Color(51, 102, 204)! // Bright blue
const c3 = Color(102, 153, 255)! // Light blue
const c4 = Color(204, 229, 255)! // Very light blue
const c5 = Color(255, 255, 255)! // White

print "Colors created"!

// Draw horizontal bands
canvas.rect -1, -1, 400, 50, c0!
canvas.rect -1, 49, 400, 50, c1!
canvas.rect -1, 99, 400, 50, c2!
canvas.rect -1, 149, 400, 50, c3!
canvas.rect -1, 199, 400, 50, c4!
canvas.rect -1, 249, 400, 50, c5!

print "Gradient drawn"!

// Add some circles for visual interest
canvas.circle 199, 149, 80, c5!
canvas.circle 199, 149, 60, c4!
canvas.circle 199, 149, 40, c3!
canvas.circle 199, 149, 20, c2!

print "Circles added"!

canvas.save "mandelbrot.png"!

print "Mandelbrot-style art saved to mandelbrot.png"!
