// Mandelbrot Set Visualization
print "Starting Mandelbrot generation..."!

const width = 100!
const height = 100!
const canvas = Canvas(width, height, "black")!

print "Canvas created"!

// Simple color palette
const c0 = "#000066"!
const c1 = "#0000FF"!
const c2 = "#6666FF"!
const c3 = "#FFFFFF"!

// Mandelbrot parameters
const maxIter = 4!

// Global counters
var row = -1!
var col = -1!

// Draw a simple gradient as a test
function drawPixel(x, y, iter) => {
   const color = iter == 0 ? c0 : (iter == 1 ? c1 : (iter == 2 ? c2 : c3))!
   canvas.pixel(x, y, color)!
}!

// Process one pixel
function processPixel() => {
   // Map to complex plane (simplified)
   const px = (col + 1) * 256 / width - 128!
   const py = (row + 1) * 256 / height - 128!
   
   // Simple iteration count (just based on position for now)
   const iter = ((col + row) % 4)!
   
   drawPixel(col, row, iter)!
   
   col = col + 1!
}!

// Process one row
function processRow() => {
   col = -1!
   
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   processPixel()!
   
   row = row + 1!
}!

print "Starting to draw..."!

processRow()!
processRow()!
processRow()!
processRow()!
processRow()!
processRow()!
processRow()!
processRow()!
processRow()!
processRow()!

print "Drawing complete!"!

canvas.save("mandelbrot.png")!

print "Mandelbrot set saved to mandelbrot.png"!
