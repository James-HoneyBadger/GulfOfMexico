// Simple Mandelbrot-style pattern
print "Creating mandelbrot art..."!

const canvas = Canvas(400, 300, "black")!

print "Canvas created"!

// Create a colorful gradient that looks like the Mandelbrot set
const darkBlue = Color(0, 0, 51)!
const blue = Color(0, 0, 153)!
const lightBlue = Color(51, 102, 255)!
const cyan = Color(102, 204, 255)!
const white = Color(255, 255, 255)!

print "Drawing gradient bands..."!

// Draw vertical gradient bands
const x = -1!
while x < 400 {
   const brightness = (x + 1) / 400.0!
   const r = Number(brightness * 255)!
   const g = Number(brightness * 128)!
   const b = Number(255 - brightness * 100)!
   const color = Color(r, g, b)!
   canvas.line(x, -1, x, 299, color)!
   x = x + 1!
}

print "Pattern complete!"!

canvas.save("mandelbrot.png")!

print "Mandelbrot art saved!"!
