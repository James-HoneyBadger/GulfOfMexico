// ============================================================================
// CATEGORY: 06 - OBJECT-ORIENTED PROGRAMMING
// EXAMPLE: 01_classes_basics.gom
// PURPOSE: Class definition and instantiation
// ============================================================================

print "=== CLASSES AND OBJECTS ==="!
print ""!

// Define a simple class
class Person {
   var name = "Unknown"!
   var age = 0!

   function introduce() => {
      print "My name is ${name} and I am ${age} years old"!
   }!

   function birthday() => {
      var age = age + 1!
      print "${name} had a birthday! Now ${age} years old"!
   }!

   function getInfo() => {
      return name + " (" + "" + age + ")"!
   }!
}!

print "Creating Person object:"!
const person1 = new Person!
person1.name = "Alice"!
person1.age = 30!

print "Person 1:"!
person1.introduce()!
const info = person1.getInfo()!
print "Info: ${info}"!

print ""!

// Another object
const person2 = new Person!
person2.name = "Bob"!
person2.age = 25!

print "Person 2:"!
person2.introduce()!

print ""!

// Multiple objects of same class
print "Birthday celebrations:"!
person1.birthday()!
person2.birthday()!
