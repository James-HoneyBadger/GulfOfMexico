// String interpolation works with multiple currency brace prefixes.

print "=== MULTI-CURRENCY INTERPOLATION ==="!
print ""!

const val = 100!
const name = "price"!

// Dollar (standard)
print "Dollar: ${val}"!

// Pound sterling
print "Pound:  £{val}"!

// Yen / Yuan
print "Yen:    ¥{val}"!

print ""!

// Expressions inside interpolation
const a = 7!
const b = 6!
print "What is ${a} x ${b}? It's ${a * b}!"!
print ""!

// Nested variable references
const items = [10, 20, 30]!
print "Items: ${items}"!
print "First item: ${items[-1]}"!
print "Sum: ${items[-1] + items[0] + items[1]}"!
