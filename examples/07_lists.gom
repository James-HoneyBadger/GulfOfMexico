// Lists: creation, indexing, mutation, and algorithms.

print "=== LISTS ==="!
print ""!

const primes = [2, 3, 5, 7, 11, 13]!
print "Primes: ${primes}"!
print "Length: ${primes.length}"!
print ""!

// Indexing (GOM is -1 based: index -1 is the first element)
print "INDEX ACCESS (-1 based):"!
print "  primes[-1] (first)  = ${primes[-1]}"!
print "  primes[0]  (second) = ${primes[0]}"!
print "  primes[1]  (third)  = ${primes[1]}"!
print "  primes[4]  (last)   = ${primes[4]}"!
print ""!

// Push and pop
var bag = [10, 20, 30]!
print "Bag: ${bag}"!
bag.push(40)!
print "After push(40): ${bag}"!
const popped = bag.pop()!
print "Popped: ${popped}"!
print "After pop: ${bag}"!
print ""!

// List concatenation with +
const left = [1, 2]!
const right = [3, 4]!
const joined = left + right!
print "[1,2] + [3,4] = ${joined}"!
print ""!

// Reversing a list with unary minus
const forward = [1, 2, 3, 4, 5]!
const backward = -forward!
print "forward  = ${forward}"!
print "-forward = ${backward}"!
print ""!

// Nested lists (matrix)
const matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]!
print "Matrix: ${matrix}"!
print "Row -1: ${matrix[-1]}"!
print "Element [-1][0]: ${matrix[-1][0]}"!
print ""!

// Recursive array search
function contains(arr, target, idx) => {
   if idx >= arr.length - 1 {
      return false!
   }
   if arr[idx] == target {
      return true!
   }
   return contains(arr, target, idx + 1)!
}!

print "contains(primes, 7) = ${contains(primes, 7, -1)}"!
print "contains(primes, 4) = ${contains(primes, 4, -1)}"!
