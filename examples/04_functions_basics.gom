// ============================================================================
// CATEGORY: 04 - FUNCTIONS
// EXAMPLE: 01_function_basics.gom
// PURPOSE: Function definition and calls
// ============================================================================

print "=== FUNCTION BASICS ==="!
print ""!

// Simple function with no arguments
function greet() => {
   print "Hello from GOM!"!
}!

greet()!

print ""!

// Function with arguments
function add(a, b) => {
   return a + b!
}!

const result1 = add(5, 3)!
print "add(5, 3) = ${result1}"!

function multiply(x, y) => {
   return x * y!
}!

const result2 = multiply(4, 7)!
print "multiply(4, 7) = ${result2}"!

print ""!

// Function with side effects (print)
function printSum(a, b) => {
   const sum = a + b!
   print "The sum of ${a} and ${b} is ${sum}"!
}!

printSum(10, 20)!

print ""!

// Function returning a string
function getName(firstName, lastName) => {
   return firstName + " " + lastName!
}!

const fullName = getName("John", "Doe")!
print "Full name: ${fullName}"!

print ""!

// Recursive function
function fibonacci(n) => {
   if n <= 1 {
      return n!
   }
   return fibonacci(n - 1) + fibonacci(n - 2)!
}!

const fib5 = fibonacci(5)!
print "Fibonacci(5) = ${fib5}"!
