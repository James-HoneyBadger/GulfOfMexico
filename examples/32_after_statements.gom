// ╔═══════════════════════════════════════════════════════════════╗
// ║  32 — After Statements                                         ║
// ╚═══════════════════════════════════════════════════════════════╝
//
// `after N { ... }` schedules a block to run after an N-millisecond delay.
// It does NOT block: the rest of the program keeps running, and scheduled
// blocks fire in deadline order once their delay has elapsed.

print "starting"!

// Run a block after a short delay (10 ms):
after 10 {
   print "ran after the delay"!
}

print "finished"!

// Delays can vary; the shorter delay fires first:
after 5 {
   print "quick follow-up"!
}

// Output: starting, finished, quick follow-up, ran after the delay
