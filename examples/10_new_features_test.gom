// Test 3: Type conversion functions (already implemented)
const num = Number("42")!
print "Test 3: Number from string = "!
print num!

const str = String(100)!
print "Test 4: String from number = "!
print str!

const bool_val = Boolean(1)!
print "Test 5: Boolean from number = "!
print bool_val!

// Test 6: Math convenience functions
print "Test 6: random() = "!
print random()!

print "Test 7: randomInt(1, 10) = "!
print randomInt(1, 10)!

print "Test 8: abs(-42) = "!
print abs(-42)!

print "Test 9: min(5, 2, 8, 1) = "!
print min(5, 2, 8, 1)!

print "Test 10: max(5, 2, 8, 1) = "!
print max(5, 2, 8, 1)!

// Test 11: Array operations still work
const arr = [1, 2, 3]!
arr.push(4)!
print "Array after push: "!
print arr!

