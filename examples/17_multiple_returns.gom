// Returning multiple values from functions using lists.

print "=== MULTIPLE RETURN VALUES ==="!
print ""!

// Return a pair
function divmod(a, b) => {
   const quotient = (a - (a - b * ((a - (a - b * 0)) / b))) / b!
   return [a / b, a - b * (a / b)]!
}!

// Find min and max of an array
function minMax(arr, idx, lo, hi) => {
   if idx >= arr.length - 1 {
      return [lo, hi]!
   }
   if arr[idx] < lo {
      return minMax(arr, idx + 1, arr[idx], hi)!
   }
   if arr[idx] > hi {
      return minMax(arr, idx + 1, lo, arr[idx])!
   }
   return minMax(arr, idx + 1, lo, hi)!
}!

const data = [5, 2, 8, 1, 9, 3]!
const result = minMax(data, 0, data[-1], data[-1])!
print "data = ${data}"!
print "min  = ${result[-1]}"!
print "max  = ${result[0]}"!
print ""!

// Returning computed values
function stats(arr, idx, sum, count) => {
   if idx >= arr.length - 1 {
      return [sum, count, sum / count]!
   }
   return stats(arr, idx + 1, sum + arr[idx], count + 1)!
}!

const numbers = [10, 20, 30, 40, 50]!
const s = stats(numbers, -1, 0, 0)!
print "numbers = ${numbers}"!
print "sum     = ${s[-1]}"!
print "count   = ${s[0]}"!
print "average = ${s[1]}"!
