// Classes and object-oriented programming.
// GOM enforces single-instance-per-class.
// Properties are set externally via dot assignment.

print "=== CLASSES ==="!
print ""!

class Counter {
   var count = 0!

   function value() => {
      return count!
   }!

   function display() => {
      print "Counter: ${count}"!
   }!
}!

const c = new Counter!
c.display()!
c.count = c.count + 1!
c.count = c.count + 1!
c.count = c.count + 1!
c.display()!
print "Value: ${c.value()}"!
print ""!

// A class with computed properties
class Rectangle {
   var width = 0!
   var height = 0!

   function area() => {
      return width * height!
   }!

   function perimeter() => {
      const sum = width + height!
      return 2 * sum!
   }!

   function describe() => {
      const a = area()!
      const p = perimeter()!
      print "${width}x${height} rectangle: area=${a}, perimeter=${p}"!
   }!
}!

const rect = new Rectangle!
rect.width = 5!
rect.height = 3!
rect.describe()!
print ""!

// Property access and modification
class Dog {
   var name = "Rex"!
   var tricks = 0!

   function info() => {
      return "${name} knows ${tricks} tricks"!
   }!
}!

const dog = new Dog!
dog.name = "Buddy"!
dog.tricks = dog.tricks + 1!
print "Learned trick 1"!
dog.tricks = dog.tricks + 1!
print "Learned trick 2"!
dog.tricks = dog.tricks + 1!
print "Learned trick 3"!
print dog.info()!
