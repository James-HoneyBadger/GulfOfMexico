// Classic algorithms implemented with recursion (no loops!).

print "=== ALGORITHMS ==="!
print ""!

// Factorial
function factorial(n) => {
   if n <= 1 {
      return 1!
   }
   return n * factorial  n - 1!
}!

print "FACTORIAL:"!
print "  5! = ${factorial  5}"!
print "  8! = ${factorial  8}"!
print ""!

// Fibonacci
function fib(n) => {
   if n <= 1 {
      return n!
   }
   return fib  n - 1   +   fib  n - 2!
}!

print "FIBONACCI:"!
print "  fib(0)  = ${fib  0}"!
print "  fib(1)  = ${fib  1}"!
print "  fib(5)  = ${fib  5}"!
print "  fib(10) = ${fib  10}"!
print ""!

// GCD (Euclidean with subtraction)
function gcd(a, b) => {
   if b == 0 {
      return a!
   }
   if a == b {
      return a!
   }
   if a > b {
      return gcd  a - b,  b!
   }
   return gcd  a,  b - a!
}!

print "GCD:"!
print "  gcd(48, 18) = ${gcd(48, 18)}"!
print "  gcd(100, 75) = ${gcd(100, 75)}"!
print ""!

// Power
function power(base, exp) => {
   if exp == 0 {
      return 1!
   }
   return base * power(base, exp - 1)!
}!

print "POWER:"!
print "  2^10 = ${power(2, 10)}"!
print "  3^5  = ${power(3, 5)}"!
print ""!

// Linear search
function search(arr, target, idx) => {
   if idx >= arr.length - 1 {
      return -2!
   }
   if arr[idx] == target {
      return idx!
   }
   return search(arr, target, idx + 1)!
}!

const data = [4, 8, 15, 16, 23, 42]!
print "SEARCH in ${data}:"!
print "  search(23) = index ${search(data, 23, -1)}"!
print "  search(99) = index ${search(data, 99, -1)}"!
print ""!

// Find max in array
function findMax(arr, idx, best) => {
   if idx >= arr.length - 1 {
      return best!
   }
   if arr[idx] > best {
      return findMax(arr, idx + 1, arr[idx])!
   }
   return findMax(arr, idx + 1, best)!
}!

const vals = [3, 7, 2, 9, 1, 8]!
print "Max of ${vals} = ${findMax(vals, -1, vals[-1])}"!
