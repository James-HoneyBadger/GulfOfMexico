print "=== STRING OPERATIONS AND MANIPULATION ==="!
print ""!

// String basics
const name = "Gulf of Mexico"!
const word = "Programming"!

print "String 1: ${name}"!
print "String 2: ${word}"!
print ""!

// String properties
print "PROPERTIES:"!
print "Length of '${name}': ${name.length}"!
print "Length of '${word}': ${word.length}"!

print ""!

// String concatenation
const greeting = "Hello, " + name + "!"!
print "Concatenation: ${greeting}"!

print ""!

// String in interpolation
const x = 10!
const y = 20!
const message = "x is ${x} and y is ${y}"!
print "Interpolation: ${message}"!

print ""!

// Building strings dynamically
function repeatString(str, times) => {
   if times <= 0 {
      return ""!
   }
   return str + repeatString(str, times - 1)!
}!

const repeated = repeatString("ab", 4)!
print "repeatString('ab', 4) = '${repeated}'"!

print ""!

// Creating sentences from arrays
const words = ["Hello", "from", "Gulf", "of", "Mexico"]!
function joinWords(arr, idx, separator) => {
   if idx >= arr.length {
      return ""!
   }
   if idx == arr.length - 1 {
      return arr[idx]!
   }
   return arr[idx] + separator + joinWords(arr, idx + 1, separator)!
}!

const sentence = joinWords(words, 0, " ")!
print "Joined: ${sentence}"!

print ""!

// String comparison
const str1 = "hello"!
const str2 = "hello"!
const str3 = "world"!

print "COMPARISON:"!
print "'${str1}' == '${str2}': ${str1 == str2}"!
print "'${str1}' == '${str3}': ${str1 == str3}"!
