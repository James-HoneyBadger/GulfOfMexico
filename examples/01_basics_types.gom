// ============================================================================
// CATEGORY: 01 - BASICS
// EXAMPLE: 03_types.gom
// PURPOSE: Different data types (numbers, strings, booleans, arrays)
// ============================================================================

print "=== GULF OF MEXICO TYPES ==="!
print ""!

// Numbers - integers and floats
const intNum = 42!
const floatNum = 3.14!
const negative = -100!
const scientific = 1.5e2!

print "NUMBERS:"!
print "Integer: ${intNum}"!
print "Float: ${floatNum}"!
print "Negative: ${negative}"!
print "Scientific: ${scientific}"!
print ""!

// Strings
const greeting = "Hello"!
const quote = "The answer is 42"!
const empty = ""!

print "STRINGS:"!
print "Greeting: ${greeting}"!
print "Quote: ${quote}"!
print "Empty string length: ${empty.length}"!
print ""!

// Booleans (three-valued: true, false, maybe)
const trueVal = true!
const falseVal = false!
const uncertain = maybe!

print "BOOLEANS (Three-Valued Logic):"!
print "True: ${trueVal}"!
print "False: ${falseVal}"!
print "Maybe: ${uncertain}"!
print ""!

// Arrays (lists)
const numbers = [1, 2, 3, 4, 5]!
const mixed = [42, "hello", true]!
const nested = [[1, 2], [3, 4], [5, 6]]!

print "ARRAYS:"!
print "Numbers: ${numbers}"!
print "Mixed types: ${mixed}"!
print "Nested: ${nested}"!
print ""!

// Array access (GOM features -1 based indexing)
print "ARRAY ACCESS:"!
print "First element (index 0): ${numbers[0]}"!
print "Last element (index -1): ${numbers[-1]}"!
print "Second to last (index -2): ${numbers[-2]}"!
print "Array length: ${numbers.length}"!
