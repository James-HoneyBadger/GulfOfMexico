// ============================================================================
// CATEGORY: 09 - DEMOS AND APPLICATIONS
// EXAMPLE: 02_calculator.gom
// PURPOSE: A simple calculator application
// ============================================================================

print "=== CALCULATOR APPLICATION ==="!
print ""!

// Calculator class
class Calculator {
   var result = 0!

   function add(value) => {
      var result = result + value!
      print "Result: ${result}"!
      return result!
   }!

   function subtract(value) => {
      var result = result - value!
      print "Result: ${result}"!
      return result!
   }!

   function multiply(value) => {
      var result = result * value!
      print "Result: ${result}"!
      return result!
   }!

   function divide(value) => {
      if value != 0 {
         var result = result / value!
         print "Result: ${result}"!
      }
   }!

   function clear() => {
      var result = 0!
      print "Cleared"!
   }!

   function display() => {
      return result!
   }!
}!

print "Creating calculator:"!
const calc = new Calculator!

print ""!
print "OPERATIONS:"!
print "Starting value: 0"!

print ""!
print "Add 10:"!
calc.add(10)!

print ""!
print "Multiply by 2:"!
calc.multiply(2)!

print ""!
print "Subtract 5:"!
calc.subtract(5)!

print ""!
print "Divide by 5:"!
calc.divide(5)!

print ""!
const finalResult = calc.display()!
print "Final result: ${finalResult}"!
