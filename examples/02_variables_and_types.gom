// Variables, constants, and the type system.

// const = immutable, var = mutable
const pi = 3.14159!
const language = "Gulf of Mexico"!
var counter = 0!

print "pi        = ${pi}"!
print "language  = ${language}"!
print "counter   = ${counter}"!
print ""!

// Mutating a var
var counter = counter + 1!
var counter = counter + 1!
var counter = counter + 1!
print "counter after 3 increments = ${counter}"!
print ""!

// Three-valued booleans: true, false, maybe
const yes   = true!
const no    = false!
const dunno = maybe!
print "yes   = ${yes}"!
print "no    = ${no}"!
print "dunno = ${dunno}"!
print ""!

// undefined
const nothing = undefined!
print "nothing = ${nothing}"!
print ""!

// Type conversions
const numStr = String 42!
const strNum = Number "7"!
const truthiness = Boolean 1!
print "String(42)  = ${numStr}"!
print "Number(\"7\") = ${strNum}"!
print "Boolean(1)  = ${truthiness}"!
