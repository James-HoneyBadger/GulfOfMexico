// ============================================================================
// CATEGORY: 01 - BASICS
// EXAMPLE: 02_variables.gom
// PURPOSE: Variable and constant declarations with different types
// ============================================================================

// Constants (immutable)
const PI = 3.14159!
const NAME = "Gulf of Mexico"!
const VERSION = 1!

// Variables (mutable)
var counter = 0!
var message = "Welcome"!
var temperature = 25.5!

print "Constants:"!
print "PI = ${PI}"!
print "NAME = ${NAME}"!
print "VERSION = ${VERSION}"!

print ""!
print "Variables:"!
print "counter = ${counter}"!
print "message = ${message}"!
print "temperature = ${temperature}"!

// Modifying variables
var counter = counter + 10!
print ""!
print "After modification:"!
print "counter = ${counter}"!
