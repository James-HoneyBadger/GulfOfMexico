// The delete keyword: erase variables, values, even keywords.

print "=== DELETE ==="!
print ""!

// Delete a variable
var greeting = "Hi there"!
print "Before delete: ${greeting}"!
delete greeting!
print "After delete: greeting is gone"!
print ""!

// Delete a value — the number 7 ceases to exist
print "Before: 6 + 1 = ${6 + 1}"!
delete 7!
print "After deleting 7: it no longer exists"!
print ""!

// Delete a keyword — remove maybe
const m = maybe!
print "maybe = ${m}"!
delete maybe!
print "Deleted the keyword maybe"!
print ""!

// You can even delete delete itself
print "Deleting the delete keyword..."!
delete delete!
print "The delete keyword has been deleted."!
print "No more deletions possible."!
