// Variable lifetimes: variables that expire after N statements.

print "=== LIFETIMES ==="!
print ""!

// A variable that lives for 3 statements
var temp <3> = "I exist for 3 lines"!
print "Line 1: ${temp}"!
print "Line 2: ${temp}"!
print "Line 3: ${temp}"!
// After 3 statements, temp is gone

print ""!
print "temp has expired after 3 statements."!
print ""!

// Regular variable for comparison (infinite lifetime)
var forever = "I last forever"!
print "forever = ${forever}"!
print "forever = ${forever}"!
print "forever = ${forever}"!
print "forever = ${forever}"!
print "Still here: ${forever}"!
