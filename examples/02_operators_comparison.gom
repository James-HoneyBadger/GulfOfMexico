// ============================================================================
// CATEGORY: 02 - OPERATORS
// EXAMPLE: 02_comparison.gom
// PURPOSE: Comparison and logical operators
// ============================================================================

print "=== COMPARISON AND LOGICAL OPERATORS ==="!
print ""!

const x = 10!
const y = 20!
const z = 10!

print "Values: x = ${x}, y = ${y}, z = ${z}"!
print ""!

// Comparison operators
const eq1 = x == z!
const eq2 = x == y!
const neq = x != y!
const lt = x < y!
const gt = x > y!
const lte = x <= z!
const gte = x >= z!

print "COMPARISON OPERATORS:"!
print "x == z: ${eq1}"!
print "x == y: ${eq2}"!
print "x != y: ${neq}"!
print "x < y: ${lt}"!
print "x > y: ${gt}"!
print "x <= z: ${lte}"!
print "x >= z: ${gte}"!
print ""!

// Logical operators (AND, OR, NOT)
const t = true!
const f = false!
const m = maybe!

print "LOGICAL OPERATORS (Three-Valued Logic):"!
print "true AND true: ${t && t}"!
print "true AND false: ${t && f}"!
print "true OR false: ${t || f}"!
print "false OR false: ${f || f}"!
print "NOT true: ${!t}"!
print "NOT false: ${!f}"!
print ""!

// Complex expressions
const complex1 = (x < y) && (y > 5)!
const complex2 = (x == z) || (y > 30)!
const complex3 = !(x == y)!

print "COMPLEX EXPRESSIONS:"!
print "(x < y) AND (y > 5): ${complex1}"!
print "(x == z) OR (y > 30): ${complex2}"!
print "NOT (x == y): ${complex3}"!
