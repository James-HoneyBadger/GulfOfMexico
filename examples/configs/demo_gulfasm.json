    "description": "Assembly-like minimalist language",
    "author": "Extreme Demo",
    "target_interpreter": "python"
  },
  "keywords": {
    "mov": {
      "original": "mov",
      "custom": "mov",
      "category": "instruction",
      "description": "Move value to register"
    },
    "add": {
      "original": "add",
      "custom": "add",
      "category": "instruction",
      "description": "Add values"
    },
    "sub": {
      "original": "sub",
      "custom": "sub",
      "category": "instruction",
      "description": "Subtract values"
    },
    "jmp": {
      "original": "jmp",
      "custom": "jmp",
      "category": "control",
      "description": "Jump to label"
    },
    "cmp": {
      "original": "cmp",
      "custom": "cmp",
      "category": "instruction",
      "description": "Compare values"
    },
    "label": {
      "original": "label",
      "custom": "label",
      "category": "control",
      "description": "Define label"
    },
    "call": {
      "original": "call",
      "custom": "call",
      "category": "control",
      "description": "Call procedure"
    },
    "ret": {
      "original": "ret",
      "custom": "ret",
      "category": "control",
      "description": "Return from procedure"
    }
  },
  "functions": {
    "syscall": {
      "name": "syscall",
      "arity": {
        "name": "syscall",
        "arity": -1,
        "implementation": null,
        "description": "System call",
        "enabled": true
      },
      "implementation": null,
      "description": "",
      "enabled": true
    }
  },
  "operators": {
