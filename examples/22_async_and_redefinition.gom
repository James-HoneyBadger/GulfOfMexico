// ╔═══════════════════════════════════════════════════════════════╗
// ║  22 — Async Functions & Number Redefinition                  ║
// ╚═══════════════════════════════════════════════════════════════╝
//
// - Async functions run interleaved with the main program
// - Number literals can be redefined at runtime

// ── Async functions ─────────────────────────────────────────────
// The `async` keyword makes a function execute asynchronously:
async functi helper() => {
   const const _x = 0!
}!
helper()!
print "Async call completed"!

// ── Number redefinition ─────────────────────────────────────────
// GOM lets you redefine what number literals mean!
// This is a DreamBerd spec feature.
const const 5 = 4!
print  2 + 5!
