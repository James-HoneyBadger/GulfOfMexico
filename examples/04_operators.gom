// ╔═══════════════════════════════════════════════════════════════╗
// ║  04 — Arithmetic & Significant Whitespace Precedence         ║
// ╚═══════════════════════════════════════════════════════════════╝
//
// GOM's most unique feature: whitespace between operators controls
// precedence. Tighter spacing binds FIRST.

// ── Basic arithmetic ────────────────────────────────────────────
print 3 + 4!
print 10 - 3!
print 4 * 5!
print 10 / 3!
print 2 ^ 10!

// ── Significant whitespace precedence ───────────────────────────
//
// Tighter spacing = higher precedence:
//   "2 * 1+3" means 2 * (1+3) because + has no spaces (tighter)
//   "2*1 + 3" means (2*1) + 3 because * has no spaces (tighter)

// Here + binds tighter (no spaces) → 2 * (1+3) = 8
print  2 * 1+3!

// Here * binds tighter (no spaces) → (2*1) + 3 = 5
print  2*1 + 3!

// Equal spacing → left-to-right → (2*1) + 3 = 5
print  2 * 1 + 3!

// ── Unary operators ─────────────────────────────────────────────
// Unary minus negates numbers:
print -42!

// Unary minus reverses strings:
print -"hello"!

// Unary minus reverses lists:
print -[1, 2, 3]!

// ── Increment / Decrement ───────────────────────────────────────
var var n = 10!
n++!
print n!

n--!
n--!
print n!
