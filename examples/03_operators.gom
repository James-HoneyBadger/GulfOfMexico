// Arithmetic, comparison, logical, and string operators.

const a = 15!
const b = 4!
print "a = ${a}, b = ${b}"!
print ""!

// Arithmetic
print "ARITHMETIC:"!
print "  a + b  = ${a + b}"!
print "  a - b  = ${a - b}"!
print "  a * b  = ${a * b}"!
print "  a / b  = ${a / b}"!
print "  a ^ b  = ${a ^ b}"!
print "  -a     = ${-a}"!
print ""!

// Comparison
print "COMPARISON:"!
print "  a < b  = ${a < b}"!
print "  a > b  = ${a > b}"!
print "  a <= b = ${a <= b}"!
print "  a >= b = ${a >= b}"!
print "  a == b = ${a == b}"!
print "  a ;= b = ${a ;= b}"!
print ""!

// Logical (three-valued)
const t = true!
const f = false!
const m = maybe!
print "LOGICAL:"!
print "  true  & true  = ${t & t}"!
print "  true  & false = ${t & f}"!
print "  true  | false = ${t | f}"!
print "  false | false = ${f | f}"!
print "  ;true         = ${;t}"!
print "  ;false        = ${;f}"!
print "  ;maybe        = ${;m}"!
print ""!

// String concatenation
const first = "Gulf"!
const second = "Mexico"!
const full = first + " of " + second!
print "STRINGS:"!
print "  ${first} + \" of \" + ${second} = ${full}"!
