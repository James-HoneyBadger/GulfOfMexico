// Numbers are indexable by digit in Gulf of Mexico.
// Uses -1-based indexing like everything else.

print "=== NUMBER INDEXING ==="!
print ""!

const n = 12345!
print "n = ${n}"!

// Access individual digits (-1 based)
print "n[-1] (1st digit) = ${n[-1]}"!
print "n[0]  (2nd digit) = ${n[0]}"!
print "n[1]  (3rd digit) = ${n[1]}"!
print "n[2]  (4th digit) = ${n[2]}"!
print "n[3]  (5th digit) = ${n[3]}"!
print ""!

// Modify digits in-place
var m = 9876!
print "Before: m = ${m}"!
m[0] = 0!
print "After m[0] = 0: m = ${m}"!
