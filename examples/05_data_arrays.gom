// ============================================================================
// CATEGORY: 05 - DATA STRUCTURES
// EXAMPLE: 01_arrays.gom
// PURPOSE: Array operations and manipulations
// ============================================================================

print "=== ARRAY OPERATIONS ==="!
print ""!

// Array creation
const arr = [10, 20, 30, 40, 50]!
print "Original array: ${arr}"!
print ""!

// Array access
print "ARRAY ACCESS:"!
print "First element (index 0): ${arr[0]}"!
print "Last element (index -1): ${arr[-1]}"!
print "Second element (index 1): ${arr[1]}"!
print "Second to last (index -2): ${arr[-2]}"!
print "Length: ${arr.length}"!

print ""!

// Array methods
print "ARRAY METHODS:"!
var mutableArr = [1, 2, 3]!
print "Original: ${mutableArr}"!

mutableArr.push(4)!
print "After push(4): ${mutableArr}"!

mutableArr.push(5)!
print "After push(5): ${mutableArr}"!

const popped = mutableArr.pop()!
print "Popped value: ${popped}"!
print "After pop: ${mutableArr}"!

print ""!

// Array literal with different types
const mixed = [42, "hello", true, 3.14]!
print "Mixed array: ${mixed}"!
print "Type at index 0: ${mixed[0]}"!
print "Type at index 1: ${mixed[1]}"!

print ""!

// Nested arrays
const matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]!
print "Matrix: ${matrix}"!
print "First row: ${matrix[0]}"!
print "First element of first row: ${matrix[0][0]}"!

print ""!

// Creating arrays with functions
function createRange(start, end) => {
   if start > end {
      return []!
   }
   const first = [start]!
   const rest = createRange(start + 1, end)!
   return first + rest!
}!

const range = createRange(1, 5)!
print "Range 1-5: ${range}"!
