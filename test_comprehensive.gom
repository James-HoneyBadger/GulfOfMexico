// Comprehensive Gulf of Mexico Test Program
// Tests a wide variety of language features

print "=== Gulf of Mexico Comprehensive Test ==="!
print ""!

// ============================================================================
// Section 1: Basic Variables and Types
// ============================================================================
print "1. VARIABLES AND TYPES"!

const intVal = 42!
var floatVal = 3.14!
const strVal = "Hello, GOM!"!
const boolVal = true!

print "Integer: ${intVal}"!
print "Float: ${floatVal}"!
print "String: ${strVal}"!
print "Boolean: ${boolVal}"!
print ""!

// ============================================================================
// Section 2: Arithmetic Operations
// ============================================================================
print "2. ARITHMETIC OPERATIONS"!

var a = 10!
var b = 3!

print "a = ${a}, b = ${b}"!
print "Addition: ${a + b}"!
print "Subtraction: ${a - b}"!
print "Multiplication: ${a * b}"!
print "Division: ${a / b}"!
print "Power: ${a ^ b}"!
print ""!

// ============================================================================
// Section 3: String Operations
// ============================================================================
print "3. STRING OPERATIONS"!

const str1 = "Hello"!
const str2 = "World"!
const combined = str1 + " " + str2!

print "String 1: ${str1}"!
print "String 2: ${str2}"!
print "Combined: ${combined}"!
print "Length: ${combined.length}"!
print ""!

// ============================================================================
// Section 4: Arrays and Indexing
// ============================================================================
print "4. ARRAYS AND INDEXING"!

const arr = [1, 2, 3, 4, 5]!

print "Array: ${arr}"!
print "First element (arr[0]): ${arr[0]}"!
print "Last element (arr[-1]): ${arr[-1]}"!
print "Length: ${arr.length}"!

// Test array manipulation
var numbers = [10, 20, 30]!
numbers.push 40!
print "After push: ${numbers}"!
print ""!

// ============================================================================
// Section 5: Maps/Dictionaries
// ============================================================================
print "5. MAPS AND DICTIONARIES"!

// Note: Map() as a builtin is not yet implemented
// We would need: const person = Map()!
// For now, we skip this section

print "Maps not yet available as builtin"!
print ""!

// ============================================================================
// Section 6: Functions
// ============================================================================
print "6. FUNCTIONS"!

function square(x) => {
   return x * x!
}!

function greet(name) => {
   print "Hello, ${name}!"!
}!

function add(x, y) => {
   return x + y!
}!

print "Square of 5: ${square(5)}"!
print "Add 7 and 3: ${add(7, 3)}"!
greet("GOM")!
print ""!

// ============================================================================
// Section 7: Conditionals
// ============================================================================
print "7. CONDITIONALS"!

const score = 85!

if score >= 90 {
   print "Grade: A"!
}

if score >= 80 {
   print "Grade: B"!
}

if score < 70 {
   print "Grade: C"!
}

// Ternary operator
const status = score >= 60 ? "Pass" : "Fail"!
print "Status: ${status}"!
print ""!

// ============================================================================
// Section 8: Classes and Objects
// ============================================================================
print "8. CLASSES AND OBJECTS"!

class Dog {
   var name = "Unknown"!
   var breed = "Mixed"!
   var age = 0!

   function bark() => {
      print "${name} the ${breed} barks: Woof!"!
   }!

   function getInfo() => {
      return "${name} is a ${breed}, ${age} years old"!
   }!
}!

const myDog = new Dog!
myDog.name = "Rex"!
myDog.breed = "Golden Retriever"!
myDog.age = 3!

myDog.bark()!
print myDog.getInfo()!
print ""!

// ============================================================================
// Section 9: Type Conversions
// ============================================================================
print "9. TYPE CONVERSIONS"!

const numStr = "123"!
const convertedNum = Number(numStr)!
print "String to number: ${convertedNum}"!

// Note: String() and Boolean() builtins not yet implemented as standalone functions
// String conversion can be done via concatenation: "" + value
print "Type conversions limited in current version"!
print ""!

// ============================================================================
// Section 10: Probabilistic Variables
// ============================================================================
print "10. PROBABILISTIC VARIABLES"!

var prob = 0.5!
print "Probabilistic variable test"!
print "Value 1: ${0.5}"!
print "Value 2: ${0.5}"!
print "Value 3: ${0.5}"!
print ""!

// ============================================================================
// Section 11: Negative Indexing (GOM Feature)
// ============================================================================
print "11. NEGATIVE INDEXING"!

const items = ["apple", "banana", "cherry", "date"]!
print "Items: ${items}"!
print "First (-1): ${items[-1]}"!
print "Second to last (-2): ${items[-2]}"!
print ""!

// ============================================================================
// Section 12: Loops with Arrays
// ============================================================================
print "12. ARRAY ITERATION"!

const colors = ["red", "green", "blue"]!
print "Colors:"!

var i = 0!
function printColor() => {
   if i < colors.length {
      print "  - ${colors[i]}"!
      var i = i + 1!
      printColor()!
   }
}!

printColor()!
print ""!

// ============================================================================
// Section 13: Complex Expressions
// ============================================================================
print "13. COMPLEX EXPRESSIONS"!

const x = 5!
const y = 3!
const z = 2!

const result1 = x + y * z!
print "5 + 3 * 2 = ${result1}"!

const result2 = (x + y) * z!
print "(5 + 3) * 2 = ${result2}"!

const result3 = x ^ y - z!
print "5 ^ 3 - 2 = ${result3}"!
print ""!

// ============================================================================
// Section 14: String Interpolation Edge Cases
// ============================================================================
print "14. STRING INTERPOLATION"!

const name = "World"!
const greeting = "Hello, ${name}!"!
print greeting!

const calc = "Math: 2 + 3 = ${2 + 3}"!
print calc!
print ""!

// ============================================================================
// Section 15: Multiple Operations and Variable Scope
// ============================================================================
print "15. MULTIPLE OPERATIONS AND VARIABLE SCOPE"!

// Note: GOM uses lexical scoping - function parameters shadow outer variables
// This test shows how the interpreter handles scope

var globalCounter = 0!

function addToCounter(amount) => {
   return globalCounter + amount!
}!

print "Global counter: ${globalCounter}"!
var result1 = addToCounter(5)!
var result2 = addToCounter(3)!
var result3 = addToCounter(7)!
print "Results from function: ${result1}, ${result2}, ${result3}"!
print ""!

// ============================================================================
// Section 16: List Operations
// ============================================================================
print "16. LIST OPERATIONS"!

var list = [1, 2, 3, 4, 5]!
print "Original list: ${list}"!

list.push(6)!
print "After push(6): ${list}"!

var popped = list.pop()!
print "Popped: ${popped}"!
print "After pop: ${list}"!
print ""!

// ============================================================================
// Final Summary
// ============================================================================
print "=== TEST COMPLETE ==="!
print "All major GOM features tested successfully!"!
