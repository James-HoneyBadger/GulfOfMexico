// Comprehensive test demonstrating compiler features

// Variables
const x = 10!
const y = 20!

// Arithmetic
const sum = x + y!
const product = x * y!
print(sum)!
print(product)!

// Functions
function multiply(a, b) => a * b!
function add(a, b) => a + b!

const result1 = multiply(5, 6)!
const result2 = add(result1, 10)!
print(result1)!
print(result2)!

// Arrays
const numbers = [10, 20, 30, 40, 50]!
print(numbers[0])!
print(numbers[-1])!
print(numbers[2])!

// Nested function calls
function square(n) => n * n!
const squared = square(7)!
print(squared)!

// Conditional
const a = 5!
const b = 10!
if a < b {
    print(999)!
}

// Complex expression
const complex = (a + b) * (a - b)!
print(complex)!
