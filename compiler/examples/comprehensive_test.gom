// Comprehensive Feature Test - Gulf of Mexico Compiler
// Tests: Maps, Built-ins, Statistical, Financial, Business, Scientific, Satirical

print "=== GULF OF MEXICO COMPILER - COMPREHENSIVE TEST ==="!

// Test 1: Map Support
print "\n1. Map/Dictionary Support"!
const config = Map !
print "  Created empty map: OK"!

// Test 2: Arrays with -1 indexing
const data = [100, 200, 300, 400, 500]!
print "\n2. Array Operations"!
print "  First element: "!
print data[0]!
print "  Last element (-1): "!
print data[-1]!

// Test 3: Math Functions
print "\n3. Math Functions"!
print "  sqrt(144) = "!
print sqrt 144!
print "  pow(3, 4) = "!
print pow 3, 4!
print "  sin(1.5708) ≈ "!
print sin 1.5708!

// Test 4: Statistical Analysis
print "\n4. Statistical Functions"!
const dataset = [85, 90, 78, 92, 88]!
print "  Dataset: [85, 90, 78, 92, 88]"!
print "  Mean: "!
print mean dataset!
print "  Median: "!
print median dataset!
print "  Std Dev: "!
print stdev dataset!

// Test 5: Financial Calculations
print "\n5. Financial Functions"!
print "  $10,000 @ 7% for 5 years (compound, monthly):"!
print "  "!
print compound_interest 10000, 0.07, 5, 12!

// Test 6: Business Metrics
print "\n6. Business Functions"!
print "  ROI (invest $5000, return $7500): "!
print roi 7500, 5000!
print "  %"!

// Test 7: Scientific Computing
print "\n7. Scientific Functions"!
const x_vals = [0, 1, 2, 3, 4]!
const y_vals = [1, 3, 5, 7, 9]!
print "  Linear regression y = 2x + 1:"!
const lr = linear_regression x_vals, y_vals!
print "  Slope & Intercept: "!
print lr!

// Test 8: Quadratic Solver
print "\n8. Quadratic Equation Solver"!
print "  Solve: x² - 7x + 12 = 0"!
const roots = quadratic_solve 1, -7, 12!
print "  Roots: "!
print roots!

