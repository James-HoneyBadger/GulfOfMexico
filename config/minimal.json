{
  "metadata": {
    "name": "Gulf of Mexico (Minimal)",
    "version": "1.0.0",
    "description": "Minimal feature set - only essential keywords and functions",
    "author": "Core Team"
  },
  "keywords": {
    "if": {
      "original": "if",
      "custom": "if",
      "category": "control",
      "description": "Conditional statement"
    },
    "function": {
      "original": "function",
      "custom": "function",
      "category": "function",
      "description": "Function definition"
    },
    "return": {
      "original": "return",
      "custom": "return",
      "category": "function",
      "description": "Return value"
    },
    "const": {
      "original": "const",
      "custom": "const",
      "category": "variable",
      "description": "Constant declaration"
    },
    "var": {
      "original": "var",
      "custom": "var",
      "category": "variable",
      "description": "Variable declaration"
    },
    "class": {
      "original": "class",
      "custom": "class",
      "category": "oop",
      "description": "Class definition"
    }
  },
  "functions": {
    "print": {
      "name": "print",
      "arity": -1,
      "implementation": "builtin.db_print",
      "description": "Print to stdout",
      "enabled": true
    },
    "Number": {
      "name": "Number",
      "arity": 1,
      "implementation": "builtin.db_to_number",
      "description": "Convert to number",
      "enabled": true
    },
    "String": {
      "name": "String",
      "arity": 1,
      "implementation": "builtin.db_to_string",
      "description": "Convert to string",
      "enabled": true
    },
    "Boolean": {
      "name": "Boolean",
      "arity": 1,
      "implementation": "builtin.db_to_boolean",
      "description": "Convert to boolean",
      "enabled": true
    },
    "List": {
      "name": "List",
      "arity": -1,
      "implementation": "builtin.GulfOfMexicoList",
      "description": "Create list",
      "enabled": true
    }
  },
  "operators": {
    "+": {"symbol": "+", "precedence": 10, "associativity": "left", "enabled": true},
    "-": {"symbol": "-", "precedence": 10, "associativity": "left", "enabled": true},
    "*": {"symbol": "*", "precedence": 20, "associativity": "left", "enabled": true},
    "/": {"symbol": "/", "precedence": 20, "associativity": "left", "enabled": true},
    "==": {"symbol": "==", "precedence": 5, "associativity": "none", "enabled": true},
    "=": {"symbol": "=", "precedence": 1, "associativity": "right", "enabled": true}
  },
  "syntax_options": {
    "array_start_index": 0,
    "allow_fractional_indexing": false,
    "flexible_quoting": true,
    "string_interpolation": false,
    "interpolation_symbol": "$",
    "single_line_comment": "//",
    "multi_line_comment_start": null,
    "multi_line_comment_end": null,
    "require_semicolons": false,
    "statement_terminator": "",
    "three_valued_logic": false,
    "probabilistic_variables": false,
    "temporal_variables": false,
    "enable_satirical_keywords": false,
    "enable_quantum_features": false,
    "enable_time_travel": false,
    "enable_gaslighting": false
  },
  "runtime": {
    "debug_mode": false,
    "strict_mode": true,
    "compatibility_mode": "standard"
  }
}
