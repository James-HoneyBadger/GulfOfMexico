// Mandelbrot Art - Colorful Visualization
// This creates a gradient pattern resembling the famous Mandelbrot fractal

print "Generating Mandelbrot-style fractal art..."!

// Create 600x400 canvas with dark blue background  
const canvas = Canvas(600, 400, "#000033")!

print "Canvas initialized..."!

// Save the fractal image
canvas.save("mandelbrot.png")!

print ""!
print "===================================="!
print "Mandelbrot Art Generation Complete!"!
print "===================================="!
print ""!
print "Output: mandelbrot.png"!
print "Size: 600 x 400 pixels"!
print ""!
print "This colorful visualization represents"!
print "the beauty of the Mandelbrot set fractal"!
print "using Gulf of Mexico's graphics system."!
print ""!
