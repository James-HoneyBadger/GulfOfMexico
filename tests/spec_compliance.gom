// COMPREHENSIVE SPEC COMPLIANCE TEST
// Tests rules from the GOM language specification
// All if blocks wrapped in functions to avoid return propagation

// === Rule 3: Indentation (multiples of 3) ===
function testIndent() => {
   if true {
      print "   3-space indent: OK"!
   }
}!
print "Rule 3: Indentation"!
testIndent()!

// === Rule 4: Significant whitespace ===
print ""!
print "Rule 4: Significant whitespace"!
const r4a = 2 * 1+3!
print "   2 * 1+3 = ${r4a}"!
const r4b = 2*1 + 3!
print "   2*1 + 3 = ${r4b}"!

// === Rule 11: Flexible quote matching ===
print ""!
print "Rule 11: Quote matching"!
const q1 = "hello"!
const q2 = 'hello'!
print "   double: ${q1}"!
print "   single: ${q2}"!

// === Rule 13: Three-valued booleans ===
print ""!
print "Rule 13: Three-valued booleans"!
print "   true: ${true}"!
print "   false: ${false}"!
print "   maybe: ${maybe}"!

// === Rule 14: Boolean conversion ===
print ""!
print "Rule 14: Boolean conversion"!
print "   Boolean(0) = ${Boolean(0)}"!
print "   Boolean(1) = ${Boolean(1)}"!
print "   Boolean(0.3) = ${Boolean(0.3)}"!

// === Rule 15: -1 based indexing ===
print ""!
print "Rule 15: -1 based indexing"!
const arr = [10, 20, 30]!
print "   arr[-1] = ${arr[-1]}"!
print "   arr[0] = ${arr[0]}"!
print "   arr[1] = ${arr[1]}"!

// === Rule 17: Number indexing ===
print ""!
print "Rule 17: Number indexing"!
var num = 12345!
print "   12345[-1] = ${num[-1]}"!
print "   12345[0] = ${num[0]}"!

// === Rule 20: noop ===
print ""!
print "Rule 20: noop"!
noop!
print "   noop executed without error"!

// === Rule 21: const vs var ===
print ""!
print "Rule 21: const vs var"!
const c1 = "immutable"!
var v1 = "mutable"!
v1 = "changed"!
print "   var reassigned: ${v1}"!

// === Rule 23: Variable lifetimes (line-based) ===
print ""!
print "Rule 23: Variable lifetimes"!
var temp <3> = "alive"!
print "   temp = ${temp}"!
print "   still alive"!
print "   last line"!

// === Rule 26: previous keyword ===
print ""!
print "Rule 26: previous keyword"!
var pv = 100!
pv = 200!
print "   current: ${pv}"!
print "   previous: ${previous pv}"!

// === Rule 30: Arithmetic ===
print ""!
print "Rule 30: Arithmetic"!
print "   5 + 3 = ${5 + 3}"!
print "   5 - 3 = ${5 - 3}"!
print "   5 / 2 = ${5 / 2}"!
print "   2 ^ 3 = ${2 ^ 3}"!

// === Rule 31: Unary minus ===
print ""!
print "Rule 31: Unary minus"!
const revlist = -[1, 2, 3]!
print "   -[1,2,3] = ${revlist}"!
const revstr = -"hello"!
print "   -hello = ${revstr}"!

// === Rule 32: Logical NOT with semicolon ===
print ""!
print "Rule 32: NOT operator (;)"!
print "   ;true = ${;true}"!
print "   ;false = ${;false}"!

// === Rule 34: Tiered equality ===
print ""!
print "Rule 34: Tiered equality"!
print "   10 = 11:   ${10 = 11}"!
print "   10 == 11:  ${10 == 11}"!
print "   10 == 10:  ${10 == 10}"!
print "   10 === 10: ${10 === 10}"!

// === Rule 36: Comparison operators ===
print ""!
print "Rule 36: Comparison"!
print "   5 > 3:  ${5 > 3}"!
print "   5 < 3:  ${5 < 3}"!
print "   5 >= 5: ${5 >= 5}"!
print "   5 <= 5: ${5 <= 5}"!

// === Rule 39: Flexible function keyword ===
print ""!
print "Rule 39: Flexible function keyword"!
f double(x) => {
   return x + x!
}!
print "   f double(3) = ${double(3)}"!
fn triple(x) => {
   return x + x + x!
}!
print "   fn triple(3) = ${triple(3)}"!

// === Rule 45: String interpolation currencies ===
print ""!
print "Rule 45: Currency interpolation"!
const val = 99!
print "   Dollar: ${val}"!
print "   Pound:  £{val}"!
print "   Yen:    ¥{val}"!

// === Rule 46: Escape sequences ===
print ""!
print "Rule 46: Escape sequences"!
print "   Tab: a\tb"!
print "   Newline: a\nb"!

// === Rule 52-53: Classes (single instance) ===
print ""!
print "Rule 52-53: Classes"!
class Animal {
   var name = "cat"!
   function speak() => {
      return name!
   }!
}!
const a = new Animal!
a.name = "dog"!
print "   Animal: ${a.speak()}"!

// === Rule 56-58: Delete ===
print ""!
print "Rule 56-58: Delete"!
var toDelete = "temp"!
delete toDelete!
print "   Variable deleted OK"!

// === Rule 60-62: Word numbers ===
print ""!
print "Rule 60-62: Word numbers"!
print "   zero = ${zero}"!
print "   five = ${five}"!
print "   nineteen = ${nineteen}"!
print "   twenty(1) = ${twenty(1)}"!
print "   hundred(5) = ${hundred(5)}"!

// === Rule 63: Named fractions ===
print ""!
print "Rule 63: Named fractions"!
print "   half = ${half}"!
print "   quarter = ${quarter}"!

// === Rule 67: Type conversions ===
print ""!
print "Rule 67: Type conversions"!
print "   String(42) = ${String(42)}"!
print "   Number(true) = ${Number(true)}"!

// === Rule 79: List methods ===
print ""!
print "Rule 79: List methods"!
var mylist = [1, 2, 3]!
mylist.push(4)!
print "   After push(4): ${mylist}"!
const popped = mylist.pop()!
print "   Popped: ${popped}"!
print "   Length: ${mylist.length}"!

// === Rule 80: List concatenation ===
print ""!
print "Rule 80: List concatenation"!
const combined = [1, 2] + [3, 4]!
print "   [1,2]+[3,4] = ${combined}"!

// === BUG FIX: Operator chars in strings ===
print ""!
print "Bug fix: Operator in strings"!
const opPlus = "+"!
const opMinus = "-"!
const opStar = "*"!
print "   plus: ${opPlus}"!
print "   minus: ${opMinus}"!
print "   star: ${opStar}"!

// === BUG FIX: Type annotations don't crash ===
print ""!
print "Bug fix: Type annotations"!
var typed: Int = 42!
print "   typed var: ${typed}"!

// === BUG FIX: if-block return propagation ===
print ""!
print "Bug fix: if-block return propagation"!
if true {
   print "   inside if block"!
}
print "   after if block (should print)"!

// === BUG FIX: when statement triggers ===
print ""!
print "Bug fix: when statement"!
var wx = 0!
when wx > 5 {
   print "   when triggered: wx > 5"!
}
wx = 10!

// === BUG FIX: next promise resolves ===
print ""!
print "Bug fix: next promise"!
var nx = 100!
const future = next nx!
print "   future before: ${future}"!
nx = 999!
print "   future after: ${future}"!

// === BUG FIX: use() signal getter ===
print ""!
print "Bug fix: use() signal"!
const sig = use 0!
sig 42!
print "   signal value: ${sig()}"!

// === BUG FIX: Math functions ===
print ""!
print "Bug fix: Math functions"!
print "   abs(-5) = ${abs(-5)}"!
print "   floor(3.7) = ${floor(3.7)}"!
print "   ceil(3.2) = ${ceil(3.2)}"!
print "   round(3.5) = ${round(3.5)}"!
print "   sqrt(16) = ${sqrt(16)}"!
print "   min(3, 7) = ${min(3, 7)}"!
print "   max(3, 7) = ${max(3, 7)}"!

// === BUG FIX: Reverse statement ===
print ""!
print "Bug fix: reverse statement"!
function testReverse() => {
   print "   A"!
   print "   B"!
   print "   C"!
   reverse noop!
}!
testReverse()!

print ""!
print "=== ALL TESTS COMPLETE ==="!
