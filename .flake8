[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503, E266
# E203: whitespace before ':' (conflicts with Black)
# E501: line too long (we'll fix these manually where critical)
# W503: line break before binary operator (conflicts with Black)
# E266: too many leading '#' for block comment

exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .venv,
    venv,
    compiler/build

per-file-ignores =
    __init__.py:F401,F403
    gulfofmexico/serialize.py:F405
    gulfofmexico/ide/qt_compat.py:F401

# Allow lambda assignments (E731) in some cases
# Allow type comparisons (E721) where needed for dynamic typing
# Allow ambiguous variable names in specific contexts (E741)
